# Credenciais do service account do Firebase (Painel Brasforno).
# Gere em: Firebase Console > Configurações do projeto > Contas de serviço > Gerar nova chave privada
# Copie este arquivo para .env.local e preencha os valores (nunca commitar .env.local).
#
# FIREBASE_PRIVATE_KEY_BASE64: pegue o campo "private_key" do JSON baixado e
# rode `node scripts/gerar-private-key-base64.js caminho/da/chave.json` para
# gerar esse valor. Cole exatamente como sair, sem aspas — funciona igual em
# dev local e nas env vars da Vercel (evita o erro "Failed to parse private key").

FIREBASE_PROJECT_ID=painel-brasforno
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY_BASE64=

# Chave que assina os cookies de sessão dos representantes.
# Gere com: npm run gerar:secret  (mínimo de 32 caracteres)
# Trocar este valor desloga todos os usuários imediatamente.
AUTH_SECRET=
